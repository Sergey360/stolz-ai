{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stolz-ai.dev/contracts/provider-overlay.schema.json",
  "title": "STOLZ A.I. Provider Overlay v1",
  "description": "A provider-only declarative overlay. It is never a runtime, adapter implementation, credential store, or certification result.",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["schema_version", "overlay_id", "availability", "reason"], "properties": { "schema_version": { "const": "1.0" }, "overlay_id": { "const": "none" }, "availability": { "const": "none" }, "reason": { "type": "string", "minLength": 1 } } },
    { "type": "object", "additionalProperties": false, "required": ["schema_version", "overlay_id", "provider_id", "availability", "certification_disposition", "expected_evidence_class", "reason", "tuple", "retry_owner", "recheck_trigger"], "properties": { "schema_version": { "const": "1.0" }, "overlay_id": { "enum": ["anthropic-api", "alibaba-model-studio", "zai"] }, "provider_id": { "enum": ["anthropic", "alibaba-model-studio", "zai"] }, "availability": { "const": "unavailable" }, "certification_disposition": { "const": "withheld" }, "expected_evidence_class": { "const": "provider_export" }, "reason": { "type": "string", "minLength": 1 }, "tuple": { "type": "object", "additionalProperties": false, "required": ["overlay_id", "provider_id", "protocol_family", "protocol_or_plan", "model_configuration"], "properties": { "overlay_id": { "enum": ["anthropic-api", "alibaba-model-studio", "zai"] }, "provider_id": { "enum": ["anthropic", "alibaba-model-studio", "zai"] }, "protocol_family": { "enum": ["anthropic-messages", "dashscope-native", "openai-compatible", "anthropic-compatible", "zai-chat-completions"] }, "protocol_or_plan": { "type": "string", "minLength": 1 }, "model_configuration": { "type": "string", "minLength": 1 } } }, "retry_owner": { "type": "string", "minLength": 1 }, "recheck_trigger": { "type": "string", "minLength": 1 } }, "allOf": [{ "if": { "properties": { "overlay_id": { "const": "anthropic-api" } } }, "then": { "properties": { "provider_id": { "const": "anthropic" }, "tuple": { "properties": { "overlay_id": { "const": "anthropic-api" }, "provider_id": { "const": "anthropic" }, "protocol_family": { "const": "anthropic-messages" } }, "required": ["overlay_id", "provider_id", "protocol_family"] } } } }, { "if": { "properties": { "overlay_id": { "const": "alibaba-model-studio" } } }, "then": { "properties": { "provider_id": { "const": "alibaba-model-studio" }, "tuple": { "properties": { "overlay_id": { "const": "alibaba-model-studio" }, "provider_id": { "const": "alibaba-model-studio" }, "protocol_family": { "enum": ["dashscope-native", "openai-compatible", "anthropic-compatible"] } }, "required": ["overlay_id", "provider_id", "protocol_family"] } } } }, { "if": { "properties": { "overlay_id": { "const": "zai" } } }, "then": { "properties": { "provider_id": { "const": "zai" }, "tuple": { "properties": { "overlay_id": { "const": "zai" }, "provider_id": { "const": "zai" }, "protocol_family": { "const": "zai-chat-completions" } }, "required": ["overlay_id", "provider_id", "protocol_family"] } } } }] },
    { "type": "object", "additionalProperties": false, "required": ["schema_version", "overlay_id", "provider_id", "availability", "scope", "protocol", "auth_reference", "source", "telemetry_mapping"], "properties": { "schema_version": { "const": "1.0" }, "overlay_id": { "enum": ["anthropic-api", "alibaba-model-studio", "zai"] }, "provider_id": { "enum": ["anthropic", "alibaba-model-studio", "zai"] }, "availability": { "const": "selected" }, "scope": { "type": "object", "additionalProperties": false, "required": ["plan_or_region", "model_configuration"], "properties": { "plan_or_region": { "type": "string", "minLength": 1 }, "model_configuration": { "type": "string", "minLength": 1 } } }, "protocol": { "type": "object", "additionalProperties": false, "required": ["family", "endpoint_template"], "properties": { "family": { "enum": ["anthropic-messages", "dashscope-native", "openai-compatible", "anthropic-compatible", "zai-chat-completions"] }, "endpoint_template": { "type": "string", "pattern": "^https://[^@/?#]+(?:/[^?#]*)?$" } } }, "auth_reference": { "type": "object", "additionalProperties": false, "required": ["mechanism", "external_secret_reference"], "properties": { "mechanism": { "enum": ["api_key", "bearer", "jwt"] }, "external_secret_reference": { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "enum": ["environment_variable", "secret_manager"] }, "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" } } } } }, "source": { "type": "object", "additionalProperties": false, "required": ["documentation_url", "retrieved_at"], "properties": { "documentation_url": { "type": "string", "pattern": "^https://[^@/?#]+(?:/[^?#]*)?$" }, "retrieved_at": { "type": "string", "format": "date" } } }, "telemetry_mapping": { "type": "object", "additionalProperties": false, "required": ["availability", "usage_fields"], "properties": { "availability": { "enum": ["unavailable", "candidate"] }, "usage_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } } }, "allOf": [{ "if": { "properties": { "overlay_id": { "const": "anthropic-api" } } }, "then": { "properties": { "provider_id": { "const": "anthropic" }, "protocol": { "properties": { "family": { "const": "anthropic-messages" } }, "required": ["family"] } } } }, { "if": { "properties": { "overlay_id": { "const": "alibaba-model-studio" } } }, "then": { "properties": { "provider_id": { "const": "alibaba-model-studio" }, "protocol": { "properties": { "family": { "enum": ["dashscope-native", "openai-compatible", "anthropic-compatible"] } }, "required": ["family"] } } } }, { "if": { "properties": { "overlay_id": { "const": "zai" } } }, "then": { "properties": { "provider_id": { "const": "zai" }, "protocol": { "properties": { "family": { "const": "zai-chat-completions" } }, "required": ["family"] } } } }] }
  ]
}
