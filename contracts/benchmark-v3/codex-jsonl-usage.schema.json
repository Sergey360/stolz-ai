{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stolz-ai.dev/contracts/benchmark-v3/codex-jsonl-usage.schema.json",
  "title": "STOLZ A.I. OpenAI Codex JSONL usage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "captured_at",
    "canonical_sha256",
    "track",
    "source_event_id",
    "input_tokens",
    "cached_input_tokens",
    "cache_write_input_tokens",
    "output_tokens",
    "reasoning_output_tokens",
    "total_tokens"
  ],
  "properties": {
    "schema_id": { "const": "codex-jsonl-usage" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "captured_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "canonical_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "track": { "const": "provider_native" },
    "source_event_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "input_tokens": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/metric" },
        { "properties": { "name": { "const": "input_tokens" }, "unit": { "const": "tokens" }, "provenance": { "const": "provider_reported" } } }
      ]
    },
    "cached_input_tokens": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/metric" },
        { "properties": { "name": { "const": "cached_input_tokens" }, "unit": { "const": "tokens" }, "provenance": { "const": "provider_reported" } } }
      ]
    },
    "cache_write_input_tokens": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/metric" },
        {
          "properties": {
            "name": { "const": "cache_write_input_tokens" },
            "unit": { "const": "tokens" },
            "provenance": { "const": "provider_reported" },
            "availability": { "enum": ["unknown", "unavailable", "withheld"] }
          }
        }
      ]
    },
    "output_tokens": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/metric" },
        { "properties": { "name": { "const": "output_tokens" }, "unit": { "const": "tokens" }, "provenance": { "const": "provider_reported" } } }
      ]
    },
    "reasoning_output_tokens": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/metric" },
        { "properties": { "name": { "const": "reasoning_output_tokens" }, "unit": { "const": "tokens" }, "provenance": { "const": "provider_reported" } } }
      ]
    },
    "total_tokens": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/metric" },
        {
          "properties": {
            "name": { "const": "total_tokens" },
            "unit": { "const": "tokens" },
            "provenance": { "const": "provider_reported" },
            "availability": { "enum": ["unknown", "unavailable", "withheld"] }
          }
        }
      ]
    }
  }
}
