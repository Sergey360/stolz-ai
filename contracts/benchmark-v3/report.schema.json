{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stolz-ai.dev/contracts/benchmark-v3/report.schema.json",
  "title": "STOLZ A.I. benchmark report v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "captured_at",
    "canonical_sha256",
    "track",
    "manifest",
    "scope",
    "admission",
    "attempts",
    "pairs",
    "metrics",
    "pricing",
    "overhead_attribution",
    "evidence",
    "claim",
    "reproduce_command"
  ],
  "properties": {
    "schema_id": { "const": "benchmark-report" },
    "schema_version": { "const": "3.0.0" },
    "record_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "captured_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "canonical_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "track": { "enum": ["provider_native", "runtime_measured"] },
    "manifest": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/recordReference" },
        { "properties": { "schema_id": { "const": "pilot-manifest" }, "schema_version": { "const": "1.0.0" } } }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "cohort_id", "runtime_id", "provider_id", "model_configuration", "configuration_sha256", "environment_sha256"],
      "properties": {
        "scenario_id": { "enum": ["reads-navigation", "build-check-invalidation", "quiet-wait-transition"] },
        "cohort_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "runtime_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "provider_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "model_configuration": { "$ref": "common.schema.json#/$defs/identifier" },
        "configuration_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "environment_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "admission": { "$ref": "report-admission.schema.json" },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "reason"],
            "properties": {
              "record_id": { "$ref": "common.schema.json#/$defs/identifier" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "pairs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "reason"],
            "properties": {
              "record_id": { "$ref": "common.schema.json#/$defs/identifier" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/deltaMetric" },
          { "properties": { "name": { "enum": ["net_token_delta", "net_cost_delta", "model_wakeups", "tool_calls", "tool_output_bytes", "wall_time_ms", "operator_interventions", "compaction_events"] } } }
        ]
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability"],
      "properties": {
        "availability": { "$ref": "common.schema.json#/$defs/availability" },
        "record": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/recordReference" },
            { "properties": { "schema_id": { "const": "pricing-identity" }, "schema_version": { "const": "1.0.0" } } }
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "if": { "properties": { "availability": { "const": "available" } }, "required": ["availability"] },
      "then": { "required": ["record"], "not": { "required": ["reason"] } },
      "else": { "required": ["reason"], "not": { "required": ["record"] } }
    },
    "overhead_attribution": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "common.schema.json#/$defs/overheadComponent" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "raw_evidence_sha256", "retained_evidence_sha256", "retained_locator"],
        "properties": {
          "attempt_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "raw_evidence_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "retained_evidence_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "retained_locator": { "type": "string", "pattern": "^retained:[A-Za-z0-9._:-]+$" }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "disposition", "scope_statement"],
      "properties": {
        "kind": { "enum": ["provider_savings_percentage", "runtime_observation", "none"] },
        "disposition": { "enum": ["published_scoped", "withheld"] },
        "value": { "type": "number" },
        "scope_statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "if": { "properties": { "disposition": { "const": "published_scoped" } }, "required": ["disposition"] },
      "then": { "required": ["value"], "not": { "required": ["reason"] } },
      "else": { "required": ["reason"], "not": { "required": ["value"] } }
    },
    "reproduce_command": {
      "type": "string",
      "pattern": "^benchmark:v3 --report [A-Za-z0-9./_-]+ --output [A-Za-z0-9./_-]+$"
    }
  }
}
