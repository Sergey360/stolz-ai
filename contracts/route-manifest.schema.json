{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stolz-ai.dev/contracts/route-manifest.schema.json",
  "title": "STOLZ A.I. Route Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "selected_route", "source_artifacts", "invalidation_inputs"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "selected_route": { "type": "string", "minLength": 1 },
    "adapter_id": { "type": ["string", "null"] },
    "source_artifacts": { "$ref": "#/$defs/requiredIdentities" },
    "conditional_references": { "$ref": "#/$defs/identities" },
    "invalidation_inputs": { "$ref": "#/$defs/identities" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "identities": { "type": "array", "items": { "$ref": "#/$defs/identity" }, "uniqueItems": true },
    "requiredIdentities": { "allOf": [{ "$ref": "#/$defs/identities" }], "minItems": 1 }
  }
}
