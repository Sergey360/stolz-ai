{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stolz-ai.dev/contracts/benchmark-record.schema.json",
  "title": "STOLZ A.I. Benchmark Record",
  "description": "Versioned benchmark aggregate. The v1 shape remains valid; v2 adds immutable identities, repetitions, explicit unavailable statistics, regression budgets, and claim boundaries.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fixture_id": {},
    "fixture_version": {},
    "required_outcome": {},
    "baseline_route": {},
    "optimized_route": {},
    "baseline": {},
    "optimized": {},
    "record_id": {},
    "record_version": {},
    "fixture": {},
    "task": {},
    "evidence_class": {},
    "repetitions": {},
    "statistics": {},
    "regression_budgets": {},
    "gates": {},
    "claim_boundary": {}
  },
  "oneOf": [
    { "$ref": "#/$defs/v1Record" },
    { "$ref": "#/$defs/v2Record" }
  ],
  "$defs": {
    "v1Record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "fixture_version", "required_outcome", "baseline_route", "optimized_route", "baseline", "optimized"],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1 },
        "fixture_version": { "type": "string", "minLength": 1 },
        "required_outcome": { "type": "string", "minLength": 1 },
        "baseline_route": { "type": "string", "minLength": 1 },
        "optimized_route": { "type": "string", "minLength": 1 },
        "baseline": { "$ref": "#/$defs/v1Measurement" },
        "optimized": { "$ref": "#/$defs/v1Measurement" }
      }
    },
    "v1Measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "token_source", "model_wakeups", "tool_calls", "wall_time_ms", "interventions", "outcome", "verification", "evidence"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "token_source": { "type": "string", "minLength": 1 },
        "model_wakeups": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "interventions": { "type": "integer", "minimum": 0 },
        "outcome": { "type": "string", "minLength": 1 },
        "verification": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "v2Record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_version", "fixture", "task", "evidence_class", "baseline", "optimized", "repetitions", "statistics", "regression_budgets", "gates", "claim_boundary"],
      "properties": {
        "record_id": { "$ref": "#/$defs/identity" },
        "record_version": { "const": "2.0" },
        "fixture": { "$ref": "#/$defs/identity" },
        "task": { "$ref": "#/$defs/identity" },
        "evidence_class": { "enum": ["fixture_only", "runtime_telemetry", "provider_native"] },
        "baseline": { "$ref": "#/$defs/routeAggregate" },
        "optimized": { "$ref": "#/$defs/routeAggregate" },
        "repetitions": { "$ref": "#/$defs/repetitions" },
        "statistics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/statistic" }
        },
        "regression_budgets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/regressionBudget" }
        },
        "gates": { "$ref": "#/$defs/gates" },
        "claim_boundary": { "$ref": "#/$defs/claimBoundary" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "configuration_identity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configuration_identity": { "$ref": "#/$defs/identity" }
      }
    },
    "unavailableComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "configuration_identity"],
      "properties": {
        "status": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1 },
        "configuration_identity": { "$ref": "#/$defs/identity" }
      }
    },
    "componentOrUnavailable": {
      "oneOf": [
        { "$ref": "#/$defs/component" },
        { "$ref": "#/$defs/unavailableComponent" }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_runtime", "adapter", "provider", "model", "collector", "optional_integrations"],
      "properties": {
        "agent_runtime": { "$ref": "#/$defs/component" },
        "adapter": { "$ref": "#/$defs/componentOrUnavailable" },
        "provider": { "$ref": "#/$defs/componentOrUnavailable" },
        "model": { "$ref": "#/$defs/componentOrUnavailable" },
        "collector": { "$ref": "#/$defs/component" },
        "optional_integrations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/component" }
        }
      }
    },
    "durableLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "routeAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "environment", "capture_method", "intervention_count", "evidence"],
      "properties": {
        "route": { "$ref": "#/$defs/identity" },
        "environment": { "$ref": "#/$defs/environment" },
        "capture_method": { "$ref": "#/$defs/component" },
        "intervention_count": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/durableLink" }
        }
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_per_route", "completed_per_route", "classification", "ordering_identity"],
      "properties": {
        "planned_per_route": { "type": "integer", "minimum": 1 },
        "completed_per_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "optimized"],
          "properties": {
            "baseline": { "type": "integer", "minimum": 0 },
            "optimized": { "type": "integer", "minimum": 0 }
          }
        },
        "classification": { "enum": ["exploratory", "publishable"] },
        "ordering_identity": { "$ref": "#/$defs/identity" }
      }
    },
    "statisticValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "available" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "enum": ["unavailable", "not_comparable"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_role", "metric", "unit", "count", "provenance", "availability", "minimum", "maximum", "median", "mean", "standard_deviation", "coefficient_of_variation"],
      "properties": {
        "route_role": { "enum": ["baseline", "optimized"] },
        "metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "provenance": { "enum": ["provider_observed", "runtime_observed", "derived", "fixture_authored", "unavailable"] },
        "availability": { "enum": ["available", "unavailable", "not_comparable"] },
        "minimum": { "$ref": "#/$defs/statisticValue" },
        "maximum": { "$ref": "#/$defs/statisticValue" },
        "median": { "$ref": "#/$defs/statisticValue" },
        "mean": { "$ref": "#/$defs/statisticValue" },
        "standard_deviation": { "$ref": "#/$defs/statisticValue" },
        "coefficient_of_variation": { "$ref": "#/$defs/statisticValue" },
        "unavailable_reason": { "type": "string", "minLength": 1 }
      }
    },
    "regressionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit", "direction", "threshold", "baseline_reference", "passed"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["must_not_increase", "must_not_decrease", "exact_match"] },
        "threshold": { "type": "number", "minimum": 0 },
        "baseline_reference": { "$ref": "#/$defs/durableLink" },
        "passed": { "type": "boolean" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "verification", "comparability", "regression", "sanitization", "publication_eligibility"],
      "properties": {
        "outcome": { "type": "boolean" },
        "verification": { "type": "boolean" },
        "comparability": { "type": "boolean" },
        "regression": { "type": "boolean" },
        "sanitization": { "type": "boolean" },
        "publication_eligibility": { "type": "boolean" }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_result", "runtime_telemetry", "provider_token_saving", "reasons"],
      "properties": {
        "fixture_result": { "enum": ["eligible", "withheld"] },
        "runtime_telemetry": { "enum": ["eligible", "withheld"] },
        "provider_token_saving": { "enum": ["eligible", "withheld"] },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
